{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RouterOutput",
  "type": "object",
  "required": [
    "sample_id",
    "round_id",
    "modality",
    "coarse_label",
    "coarse_type_candidates",
    "uncertainty",
    "task_description",
    "tool_candidates",
    "need_next_round",
    "reasoning_summary"
  ],
  "properties": {
    "sample_id": {
      "type": "string"
    },
    "round_id": {
      "type": "integer",
      "minimum": 1
    },
    "modality": {
      "type": "string",
      "enum": [
        "remote_sensing_rgb",
        "remote_sensing_multispectral",
        "unknown"
      ]
    },
    "coarse_label": {
      "type": "string",
      "enum": [
        "authentic",
        "manipulated",
        "fully_generated",
        "unknown"
      ]
    },
    "coarse_type_candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["label", "score"],
        "properties": {
          "label": {
            "type": "string",
            "enum": [
              "copy_move",
              "splicing",
              "inpainting_removal",
              "inpainting_replacement",
              "fully_generated",
              "uncertain"
            ]
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "uncertainty": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "task_description": {
      "type": "string"
    },
    "tool_candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["tool", "priority", "reason"],
        "properties": {
          "tool": {
            "type": "string"
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "need_next_round": {
      "type": "boolean"
    },
    "reasoning_summary": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
