{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SampleRecord",
  "type": "object",
  "required": [
    "sample_id",
    "source_dataset",
    "split",
    "tamper_status_l1",
    "tamper_type_l2",
    "task_mode",
    "image_path",
    "has_localization_gt",
    "question_ids",
    "attributes",
    "raw_meta"
  ],
  "properties": {
    "sample_id": {
      "type": "string"
    },
    "source_dataset": {
      "type": "string"
    },
    "source_image_id": {
      "type": ["string", "integer", "null"]
    },
    "split": {
      "type": "string",
      "enum": ["train", "val", "test", "challenge", "demo"]
    },
    "tamper_status_l1": {
      "type": "string",
      "enum": ["authentic", "manipulated", "fully_generated", "unknown"]
    },
    "tamper_type_l2": {
      "type": "string",
      "enum": [
        "copy_move",
        "splice",
        "inpainting_removal",
        "inpainting_replacement",
        "aigc_global",
        "none",
        "uncertain"
      ]
    },
    "task_mode": {
      "type": "string",
      "enum": ["classification", "classification_localization"]
    },
    "image_path": {
      "type": "string"
    },
    "original_path": {
      "type": ["string", "null"]
    },
    "tampered_path": {
      "type": ["string", "null"]
    },
    "mask_path": {
      "type": ["string", "null"]
    },
    "source_crop_path": {
      "type": ["string", "null"]
    },
    "target_crop_path": {
      "type": ["string", "null"]
    },
    "has_localization_gt": {
      "type": "boolean"
    },
    "question_ids": {
      "type": "array",
      "items": {
        "type": ["string", "integer"]
      }
    },
    "caption": {
      "type": "string"
    },
    "caption_zh": {
      "type": ["string", "null"]
    },
    "attributes": {
      "type": "object"
    },
    "raw_meta": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
