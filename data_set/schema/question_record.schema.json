{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QuestionRecord",
  "type": "object",
  "required": [
    "question_id",
    "sample_id",
    "question_type",
    "question",
    "answer",
    "is_free_text",
    "source_dataset"
  ],
  "properties": {
    "question_id": {
      "type": ["string", "integer"]
    },
    "sample_id": {
      "type": "string"
    },
    "question_type": {
      "type": "string"
    },
    "question": {
      "type": "string"
    },
    "question_zh": {
      "type": ["string", "null"]
    },
    "answer": {
      "type": ["string", "number", "boolean", "null"]
    },
    "answer_zh": {
      "type": ["string", "null"]
    },
    "is_free_text": {
      "type": "boolean"
    },
    "source_dataset": {
      "type": "string"
    },
    "source_question_id": {
      "type": ["string", "integer", "null"]
    }
  },
  "additionalProperties": false
}
